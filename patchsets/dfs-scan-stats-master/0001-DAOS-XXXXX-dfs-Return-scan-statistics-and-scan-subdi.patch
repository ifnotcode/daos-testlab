+enum {
+	/** periodically print the number of entries scanned so far to stdout */
+	DFS_SCAN_PRINT_PROGRESS = (1 << 0),
+};
+
+/** Statistics about a DFS namespace (sub)tree returned by dfs_scan() */
+typedef struct {
+	/** number of entries scanned, the directory the scan starts from is not counted */
+	uint64_t dss_nr_scanned;
+	/** number of regular files */
+	uint64_t dss_nr_files;
+	/** number of directories */
+	uint64_t dss_nr_dirs;
+	/** number of symbolic links */
+	uint64_t dss_nr_symlinks;
+	/** maximum depth of the tree, entries of the starting directory are at depth 1 */
+	uint64_t dss_max_depth;
+	/** sum of the sizes (st_size) of all regular files, in bytes */
+	uint64_t dss_total_bytes;
+	/** size of the largest regular file, in bytes */
+	uint64_t dss_largest_file;
+	/** number of entries in the largest directory */
+	uint64_t dss_largest_dir;
+} dfs_scan_stats_t;
+
+/**
+ * Walk the DFS namespace under a directory and return statistics about file/dir size and
+ * namespace structure. The size reported is the logical size of the files (the sum of st_size), not
+ * the space allocated in the pool. The walk is not atomic: entries changed while it runs may or may
+ * not be counted.
+ *
+ * \param[in]	dfs	Pointer to the mounted file system.
+ * \param[in]	dir	Open directory to scan from. Start from container root if NULL.
+ * \param[in]	flags	Bitmask of DFS_SCAN_* flags, or 0.
+ * \param[out]	stats	Statistics of the scanned tree.
+ *
+ * \return		0 on success, errno code on failure.
+ */
+int
+dfs_scan(dfs_t *dfs, dfs_obj_t *dir, uint64_t flags, dfs_scan_stats_t *stats);
+
 #if defined(__cplusplus)
 }
 #endif /* __cplusplus */
