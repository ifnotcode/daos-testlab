+int
+dfs_scan(dfs_t *dfs, dfs_obj_t *dir, uint64_t flags, dfs_scan_stats_t *stats)
+{
+	struct dfs_scan_args scan_args = {0};
+	struct timespec      now;
+	int                  rc;
+
+	if (dfs == NULL || !dfs->mounted)
+		return EINVAL;
+	if (stats == NULL)
+		return EINVAL;
+	if (flags & ~DFS_SCAN_PRINT_PROGRESS)
+		return EINVAL;
+	if (dir == NULL)
+		dir = &dfs->root;
+	if (!S_ISDIR(dir->mode))
+		return ENOTDIR;
+
+	rc = clock_gettime(CLOCK_REALTIME, &now);
+	if (rc)
+		return errno;
+
+	memset(stats, 0, sizeof(*stats));
+	scan_args.start_time = now.tv_sec;
+	scan_args.print_time = now.tv_sec;
+	scan_args.flags      = flags;
+	scan_args.stats      = stats;
+	/** entries of the starting directory are at depth 1 */
+	scan_args.cur_depth = 0;
+
+	return scan_dir(dfs, dir, &scan_args);
+}
