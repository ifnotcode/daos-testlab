+static void
+scan_create_file(dfs_t *dfs, dfs_obj_t *parent, const char *name, daos_off_t off, size_t len)
+{
+	dfs_obj_t  *file;
+	d_sg_list_t sgl;
+	d_iov_t     iov;
+	char       *buf = NULL;
+	int         rc;
+
+	rc = dfs_open(dfs, parent, name, S_IFREG | S_IWUSR | S_IRUSR, O_RDWR | O_CREAT | O_EXCL, 0,
+		      0, NULL, &file);
+	assert_int_equal(rc, 0);
+
+	if (len > 0) {
+		D_ALLOC(buf, len);
+		assert_non_null(buf);
+		d_iov_set(&iov, buf, len);
+		sgl.sg_nr     = 1;
+		sgl.sg_nr_out = 1;
+		sgl.sg_iovs   = &iov;
+		rc            = dfs_write(dfs, file, &sgl, off, NULL);
+		assert_int_equal(rc, 0);
+		D_FREE(buf);
+	}
+
+	rc = dfs_release(file);
+	assert_int_equal(rc, 0);
+}
+
+static void
+dfs_test_scan(void **state)
+{
+	test_arg_t      *arg   = *state;
+	char            *cname = "cont_scan";
+	dfs_t           *dfs;
+	dfs_obj_t       *d1, *d2, *sym, *file;
+	dfs_scan_stats_t stats;
+	char             name[16];
+	int              i;
+	int              rc;
+
+	if (arg->myrank != 0)
+		return;
+
+	rc = dfs_init();
+	assert_int_equal(rc, 0);
+	rc = dfs_connect(arg->pool.pool_str, arg->group, cname, O_CREAT | O_RDWR, NULL, &dfs);
+	assert_int_equal(rc, 0);
+
+	/*
+	 * /f0          4096 bytes
+	 * /f1          sparse, 1024 bytes written at 1 MiB
+	 * /sym -> f0
+	 * /d1/f2       100 bytes
+	 * /d1/d2/f3    10 bytes
+	 * /d1/d2/e0-4  empty files
+	 */
+	scan_create_file(dfs, NULL, "f0", 0, 4096);
+	scan_create_file(dfs, NULL, "f1", 1048576, 1024);
+	rc = dfs_open(dfs, NULL, "sym", S_IFLNK, O_RDWR | O_CREAT | O_EXCL, 0, 0, "f0", &sym);
+	assert_int_equal(rc, 0);
+	rc = dfs_release(sym);
+	assert_int_equal(rc, 0);
+	rc = dfs_open(dfs, NULL, "d1", S_IFDIR | S_IWUSR | S_IRUSR | S_IXUSR, O_RDWR | O_CREAT, 0,
+		      0, NULL, &d1);
+	assert_int_equal(rc, 0);
+	scan_create_file(dfs, d1, "f2", 0, 100);
+	rc = dfs_open(dfs, d1, "d2", S_IFDIR | S_IWUSR | S_IRUSR | S_IXUSR, O_RDWR | O_CREAT, 0, 0,
+		      NULL, &d2);
+	assert_int_equal(rc, 0);
+	scan_create_file(dfs, d2, "f3", 0, 10);
+	for (i = 0; i < 5; i++) {
+		sprintf(name, "e%d", i);
+		scan_create_file(dfs, d2, name, 0, 0);
+	}
+	rc = dfs_release(d2);
+	assert_int_equal(rc, 0);
+
+	/** scan the whole container */
+	rc = dfs_scan(dfs, NULL, 0, &stats);
+	assert_int_equal(rc, 0);
+	assert_int_equal(stats.dss_nr_scanned, 12);
+	assert_int_equal(stats.dss_nr_files, 9);
+	assert_int_equal(stats.dss_nr_dirs, 2);
+	assert_int_equal(stats.dss_nr_symlinks, 1);
+	assert_int_equal(stats.dss_max_depth, 3);
+	assert_int_equal(stats.dss_total_bytes, 4096 + 1048576 + 1024 + 100 + 10);
+	assert_int_equal(stats.dss_largest_file, 1048576 + 1024);
+	assert_int_equal(stats.dss_largest_dir, 6);
+
+	/** scan a subdirectory */
+	rc = dfs_scan(dfs, d1, 0, &stats);
+	assert_int_equal(rc, 0);
+	assert_int_equal(stats.dss_nr_scanned, 8);
+	assert_int_equal(stats.dss_nr_files, 7);
+	assert_int_equal(stats.dss_nr_dirs, 1);
+	assert_int_equal(stats.dss_nr_symlinks, 0);
+	assert_int_equal(stats.dss_max_depth, 2);
+	assert_int_equal(stats.dss_total_bytes, 110);
+	assert_int_equal(stats.dss_largest_file, 100);
+	assert_int_equal(stats.dss_largest_dir, 6);
+	rc = dfs_release(d1);
+	assert_int_equal(rc, 0);
+
+	/** invalid arguments */
+	rc = dfs_scan(dfs, NULL, 0, NULL);
+	assert_int_equal(rc, EINVAL);
+	rc = dfs_scan(dfs, NULL, ~DFS_SCAN_PRINT_PROGRESS, &stats);
+	assert_int_equal(rc, EINVAL);
+	rc = dfs_lookup(dfs, "/f0", O_RDONLY, &file, NULL, NULL);
+	assert_int_equal(rc, 0);
+	rc = dfs_scan(dfs, file, 0, &stats);
+	assert_int_equal(rc, ENOTDIR);
+	rc = dfs_release(file);
+	assert_int_equal(rc, 0);
+
+	/** the container-level scan accepts a subdirectory with or without a leading / */
+	rc = dfs_cont_scan(arg->pool.poh, cname, 0, NULL);
+	assert_int_equal(rc, 0);
+	rc = dfs_cont_scan(arg->pool.poh, cname, 0, "d1/d2");
+	assert_int_equal(rc, 0);
+	rc = dfs_cont_scan(arg->pool.poh, cname, 0, "/d1");
+	assert_int_equal(rc, 0);
+	rc = dfs_cont_scan(arg->pool.poh, cname, 0, "/nonexistent");
+	assert_int_equal(rc, ENOENT);
+
+	rc = dfs_disconnect(dfs);
+	assert_int_equal(rc, 0);
+	rc = dfs_destroy(arg->pool.pool_str, arg->group, cname, 0, NULL);
+	assert_rc_equal(rc, 0);
+	rc = dfs_fini();
+	assert_int_equal(rc, 0);
+}
