+int
+fs_scan_hdlr(struct cmd_args_s *ap, const char *dir_name, uint64_t flags, dfs_scan_stats_t *stats)
+{
+	dfs_t     *dfs;
+	dfs_obj_t *dir  = NULL;
+	char      *path = NULL;
+	int        rc, rc2;
+
+	D_ASSERT(ap != NULL);
+	D_ASSERT(stats != NULL);
+
+	rc = dfs_mount(ap->pool, ap->cont, O_RDONLY, &dfs);
+	if (rc) {
+		fprintf(ap->errstream, "failed to mount container %s: %s (%d)\n", ap->cont_str,
+			strerror(rc), rc);
+		return rc;
+	}
+
+	if (dir_name != NULL && dir_name[0] != '\0') {
+		/** dir_name is relative to the container root, the leading / is optional */
+		D_ASPRINTF(path, "%s%s", dir_name[0] == '/' ? "" : "/", dir_name);
+		if (path == NULL)
+			D_GOTO(out_umount, rc = ENOMEM);
+		rc = dfs_lookup(dfs, path, O_RDONLY, &dir, NULL, NULL);
+		if (rc) {
+			fprintf(ap->errstream, "failed to lookup %s (%s)\n", path, strerror(rc));
+			D_GOTO(out_umount, rc);
+		}
+	}
+
+	rc = dfs_scan(dfs, dir, flags, stats);
+	if (rc)
+		fprintf(ap->errstream, "failed to scan %s (%s)\n", path ? path : "/", strerror(rc));
+
+	if (dir) {
+		rc2 = dfs_release(dir);
+		if (rc2 != 0)
+			fprintf(ap->errstream, "failed to release dfs obj\n");
+	}
+out_umount:
+	D_FREE(path);
+	rc2 = dfs_umount(dfs);
+	if (rc2 != 0)
+		fprintf(ap->errstream, "failed to umount DFS container\n");
+	return rc;
+}
