+/** iterate over all entries of a directory, descending into sub-directories */
+static int
+scan_dir(dfs_t *dfs, dfs_obj_t *dir, struct dfs_scan_args *scan_args)
+{
+	daos_anchor_t anchor     = {0};
+	uint32_t      nr_entries = DFS_ITER_NR;
+	uint64_t      nr_total   = 0;
+	int           rc;
+
+	while (!daos_anchor_is_eof(&anchor)) {
+		scan_args->cur_depth++;
+		rc = dfs_iterate(dfs, dir, &anchor, &nr_entries, DFS_MAX_NAME * nr_entries, scan_cb,
+				 scan_args);
+		scan_args->cur_depth--;
+		if (rc) {
+			D_ERROR("dfs_iterate() failed: %d\n", rc);
+			return rc;
+		}
+		nr_total += nr_entries;
+		nr_entries = DFS_ITER_NR;
+	}
+
+	if (scan_args->stats->dss_largest_dir < nr_total)
+		scan_args->stats->dss_largest_dir = nr_total;
+	return 0;
+}
